## 환경변수 예시 파일(.env.example)
## - 실제 비밀값은 넣지 말고 형식만 공유합니다.
## - 로컬에서는 이 파일을 복사해 .env를 만들어 사용하세요.

DATABASE_URL=postgresql://user:password@localhost:5432/picklog

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Kakao OAuth (모바일 SDK access_token 검증용)
# 향후 토큰 검증 강화 시 활용 (현재 미사용 — REST API Key)
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# Naver Open API (블로그 검색 — 장소 리뷰 수집용)
# https://developers.naver.com/apps 에서 검색 API 등록 후 발급
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Redis (RQ 작업 큐 / 캐시)
REDIS_URL=redis://localhost:6379/0

# Apify (Instagram 게시물 스크래핑)
# https://console.apify.com/account/integrations 에서 발급
APIFY_TOKEN=your-apify-api-token
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
# 이번 달 Apify 호출 한도 (USD). 초과 시 OG 메타 fallback으로 자동 전환.
APIFY_MONTHLY_BUDGET_USD=50

# 네이버 블로그 enrichment (장소 리뷰 자동 수집 — AI 학습용)
# 월간 호출 한도 (선택). 비워두면 가드 비활성. 무료 한도 25,000/일 이내에서 설정.
NAVER_BLOG_MONTHLY_QUOTA_CALLS=
# 본문 fetch 호출 간 sleep (초). 차단 방지용. 기본 0.5
NAVER_BLOG_BODY_FETCH_SLEEP=0.5
# 본문 fetch 최대 길이 (자). 기본 2000
NAVER_BLOG_BODY_MAX_CHARS=2000

